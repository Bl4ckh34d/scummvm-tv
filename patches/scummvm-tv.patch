+static uint64 tvClockOffset, tvLastFrame;
+static bool tvFastForward;
+void retro_tv_clock_reset() { tvClockOffset = tvLastFrame = 0; tvFastForward = false; }
+void retro_tv_clock_frame(bool fastForward) {
+	uint64 now = cpu_features_get_time_usec();
+	// Preserve real time normally. Fast-forward advances at least one 60 Hz tick
+	// per frontend frame, without moving the clock backwards when released.
+	if (fastForward && tvLastFrame && now - tvLastFrame < 16667)
+		tvClockOffset += 16667 - (now - tvLastFrame);
+	tvLastFrame = now;
+	tvFastForward = fastForward;
+}
